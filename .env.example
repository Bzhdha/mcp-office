# Entra ID app (permission Graph "Sites.Selected" en lecture sur le site des modèles)
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_SITE_ID=contoso.sharepoint.com,<guid-site>,<guid-web>
SP_FOLDER=Modeles
# Alternative sans Graph : dossier local synchronisé (OneDrive/montage) -> désactive SharePoint
# TEMPLATE_DIR=/templates
MCP_API_KEY=changez-moi-long-et-aleatoire
PUBLIC_BASE_URL=https://mcp-office.intranet.example
FILE_TTL=3600
TEMPLATE_CACHE=300
MAX_INPUT=500000
DOC_LANG=fr-FR
XLSX_TABLE_STYLE=TableStyleMedium2
MAX_UPLOAD=52428800
# Famille de modèles par défaut quand le dossier en contient plusieurs (partie du nom)
# DEFAULT_TEMPLATE_PPTX=Proposition_commerciale
